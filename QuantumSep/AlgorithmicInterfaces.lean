import QuantumSep.HaarUnitary
import QuantumSep.DenseCSP
import Mathlib.MeasureTheory.Measure.Real

/-!
# Exact contracts for the permitted algorithmic inputs

The manuscript is allowed to assume efficient exact Haar sampling, the dense
Max-4-CSP PTAS, and the real-RAM cost model.  This file states those three
inputs as mathematical structures rather than unnamed propositions.  In
particular, success probabilities, approximation direction, and polynomial
runtime variables are explicit.
-/

namespace QuantumSep

open MeasureTheory ProbabilityTheory

noncomputable section

/-- A randomized procedure with an explicit probability space and step
counter. -/
structure RandomizedProcedure (Input Output : Type*) where
  Seed : Type
  seedMeasurableSpace : MeasurableSpace Seed
  seedMeasure : @Measure Seed seedMeasurableSpace
  seedProbability : @IsProbabilityMeasure Seed seedMeasurableSpace seedMeasure
  run : Input → Seed → Output
  runtime : Input → Seed → ℕ

/-- Real probability of an event in the seed space. -/
def RandomizedProcedure.eventProbability
    {Input Output : Type*} (alg : RandomizedProcedure Input Output)
    (event : Set alg.Seed) : ℝ :=
  @Measure.real alg.Seed alg.seedMeasurableSpace alg.seedMeasure event

/-- A uniform polynomial step bound in a specified natural input size. -/
def PolynomialRuntime
    {Input Output : Type*} (alg : RandomizedProcedure Input Output)
    (inputSize : Input → ℕ) : Prop :=
  ∃ C degree : ℕ, ∀ input seed,
    alg.runtime input seed ≤ C * (inputSize input + 1) ^ degree

/-- A dense ordered Max-4-CSP.  Repeated variable indices are allowed and
each predicate is explicitly `[0,1]`-valued. -/
structure DenseMaxFourCSP (Variable Alphabet : Type*)
    [Fintype Variable] [Fintype Alphabet] where
  predicate :
    Variable → Variable → Variable → Variable →
      Alphabet → Alphabet → Alphabet → Alphabet → ℝ
  predicate_mem :
    ∀ (assignment : Variable → Alphabet) a b c e,
      predicate a b c e
        (assignment a) (assignment b) (assignment c) (assignment e) ∈
          Set.Icc (0 : ℝ) 1

/-- Value of an assignment, averaged over all ordered four-tuples. -/
def DenseMaxFourCSP.value
    {Variable Alphabet : Type*}
    [Fintype Variable] [Fintype Alphabet]
    (csp : DenseMaxFourCSP Variable Alphabet)
    (assignment : Variable → Alphabet) : ℝ :=
  denseAverage4 fun a b c e =>
    csp.predicate a b c e
      (assignment a) (assignment b) (assignment c) (assignment e)

/-- Product measurable structure on all predicate coordinates. -/
@[reducible] noncomputable def denseMaxFourCSPPredicateMeasurableSpace
    (Variable Alphabet : Type*)
    [Fintype Variable] [Fintype Alphabet] :
    MeasurableSpace
      (Variable → Variable → Variable → Variable →
        Alphabet → Alphabet → Alphabet → Alphabet → ℝ) := by
  letI mA1 : MeasurableSpace (Alphabet → ℝ) :=
    MeasurableSpace.pi
  letI mA2 : MeasurableSpace (Alphabet → Alphabet → ℝ) :=
    MeasurableSpace.pi
  letI mA3 :
      MeasurableSpace (Alphabet → Alphabet → Alphabet → ℝ) :=
    MeasurableSpace.pi
  letI mA4 :
      MeasurableSpace
        (Alphabet → Alphabet → Alphabet → Alphabet → ℝ) :=
    MeasurableSpace.pi
  letI mV1 :
      MeasurableSpace
        (Variable →
          Alphabet → Alphabet → Alphabet → Alphabet → ℝ) :=
    MeasurableSpace.pi
  letI mV2 :
      MeasurableSpace
        (Variable → Variable →
          Alphabet → Alphabet → Alphabet → Alphabet → ℝ) :=
    MeasurableSpace.pi
  letI mV3 :
      MeasurableSpace
        (Variable → Variable → Variable →
          Alphabet → Alphabet → Alphabet → Alphabet → ℝ) :=
    MeasurableSpace.pi
  letI mV4 :
      MeasurableSpace
        (Variable → Variable → Variable → Variable →
          Alphabet → Alphabet → Alphabet → Alphabet → ℝ) :=
    MeasurableSpace.pi
  exact mV4

/-- The measurable structure on finite CSP instances is generated by all
predicate coordinates.  Proof fields carry no additional observable data. -/
@[reducible] noncomputable def denseMaxFourCSPMeasurableSpace
    (Variable Alphabet : Type*)
    [Fintype Variable] [Fintype Alphabet] :
    MeasurableSpace (DenseMaxFourCSP Variable Alphabet) :=
  MeasurableSpace.comap DenseMaxFourCSP.predicate
    (denseMaxFourCSPPredicateMeasurableSpace Variable Alphabet)

/-- Natural size parameter used by the PTAS contract.  The accuracy is
encoded by `ceil(1/ε)`; the alphabet cardinality is included explicitly. -/
def denseMaxFourCSPInputSize
    (variableCount alphabetCount : ℕ) (epsilon : ℝ) : ℕ :=
  variableCount + alphabetCount + Nat.ceil (1 / epsilon)

/-- Precise dense Max-4-CSP PTAS contract.

On every finite instance with a nonempty alphabet and every positive accuracy,
the returned assignment is within `epsilon` of every competing assignment with probability at least
`5/6`.  This fixed confidence is the ordinary constant-fold amplification of
the base `2/3` PTAS and does not depend on the input dimension.  The two fixed
natural constants give one uniform polynomial runtime bound in the number of
variables, with constants and degree allowed to depend on the fixed alphabet
size and fixed accuracy, exactly as in the usual PTAS definition. -/
structure DenseMaxFourCSPPTASContract where
  Seed : Type
  seedMeasurableSpace : MeasurableSpace Seed
  seedMeasure : @Measure Seed seedMeasurableSpace
  seedProbability :
    @IsProbabilityMeasure Seed seedMeasurableSpace seedMeasure
  runtimeConstant : ℕ → ℕ → ℕ
  runtimeDegree : ℕ → ℕ → ℕ
  solve :
    ∀ (Variable Alphabet : Type)
      [Fintype Variable] [Fintype Alphabet] [Nonempty Alphabet],
      DenseMaxFourCSP Variable Alphabet → ℝ →
        Seed → (Variable → Alphabet)
  runtime :
    ∀ (Variable Alphabet : Type)
      [Fintype Variable] [Fintype Alphabet] [Nonempty Alphabet],
      DenseMaxFourCSP Variable Alphabet → ℝ → Seed → ℕ
  /-- A randomized implementation is measurable jointly in the finite CSP
  instance and its fresh coins.  The finite assignment space carries its
  discrete sigma-algebra.  This is operational semantics, not an
  approximation assumption. -/
  solve_jointly_measurable :
    ∀ (Variable Alphabet : Type)
      [Fintype Variable] [Fintype Alphabet] [Nonempty Alphabet]
      (epsilon : ℝ),
      @Measurable
        (DenseMaxFourCSP Variable Alphabet × Seed)
        (Variable → Alphabet)
        (@Prod.instMeasurableSpace
          (DenseMaxFourCSP Variable Alphabet) Seed
          (denseMaxFourCSPMeasurableSpace Variable Alphabet)
          seedMeasurableSpace)
        ⊤
        (fun p => solve Variable Alphabet p.1 epsilon p.2)
  success :
    ∀ (Variable Alphabet : Type)
      [Fintype Variable] [Fintype Alphabet] [Nonempty Alphabet]
      (csp : DenseMaxFourCSP Variable Alphabet)
      (epsilon : ℝ), 0 < epsilon →
      @Measure.real Seed seedMeasurableSpace seedMeasure
        {seed | ∀ assignment,
          csp.value assignment ≤
            csp.value (solve Variable Alphabet csp epsilon seed) +
              epsilon} ≥ 5 / 6
  success_event_measurable :
    ∀ (Variable Alphabet : Type)
      [Fintype Variable] [Fintype Alphabet] [Nonempty Alphabet]
      (csp : DenseMaxFourCSP Variable Alphabet)
      (epsilon : ℝ),
      @MeasurableSet Seed seedMeasurableSpace
        {seed | ∀ assignment,
          csp.value assignment ≤
            csp.value (solve Variable Alphabet csp epsilon seed) +
              epsilon}
  /-- The same guarantee remains valid when the instance is selected by an
  independent random experiment.  This is the standard product-seed
  semantics of a randomized PTAS and rules out any hidden coupling between
  the input and the algorithm's coins. -/
  success_on_independent_random_instance :
    ∀ (Omega Variable Alphabet : Type)
      [MeasurableSpace Omega]
      (mu : Measure Omega) [IsProbabilityMeasure mu]
      [Fintype Variable] [Fintype Alphabet] [Nonempty Alphabet]
      (randomCSP : Omega → DenseMaxFourCSP Variable Alphabet)
      (epsilon : ℝ), 0 < epsilon →
      @Measure.real (Omega × Seed)
        (@Prod.instMeasurableSpace Omega Seed inferInstance
          seedMeasurableSpace)
        (mu.prod seedMeasure)
        {p | ∀ assignment,
          (randomCSP p.1).value assignment ≤
            (randomCSP p.1).value
              (solve Variable Alphabet (randomCSP p.1) epsilon p.2) +
              epsilon} ≥ 5 / 6
  independent_success_event_measurable :
    ∀ (Omega Variable Alphabet : Type)
      [MeasurableSpace Omega]
      (mu : Measure Omega) [IsProbabilityMeasure mu]
      [Fintype Variable] [Fintype Alphabet] [Nonempty Alphabet]
      (randomCSP : Omega → DenseMaxFourCSP Variable Alphabet)
      (epsilon : ℝ),
      @MeasurableSet (Omega × Seed)
        (@Prod.instMeasurableSpace Omega Seed inferInstance
          seedMeasurableSpace)
        {p | ∀ assignment,
          (randomCSP p.1).value assignment ≤
            (randomCSP p.1).value
              (solve Variable Alphabet (randomCSP p.1) epsilon p.2) +
              epsilon}
  polynomial_runtime :
    ∀ (Variable Alphabet : Type)
      [Fintype Variable] [Fintype Alphabet] [Nonempty Alphabet]
      (csp : DenseMaxFourCSP Variable Alphabet)
      (epsilon : ℝ) (seed : Seed),
      runtime Variable Alphabet csp epsilon seed ≤
        runtimeConstant
            (Fintype.card Alphabet) (Nat.ceil (1 / epsilon)) *
          (Fintype.card Variable + 1) ^
            runtimeDegree
              (Fintype.card Alphabet) (Nat.ceil (1 / epsilon))

/-- The randomized procedure associated with the PTAS's universal
independent seed space. -/
def DenseMaxFourCSPPTASContract.procedure
    (ptas : DenseMaxFourCSPPTASContract)
    (Variable Alphabet : Type)
    [Fintype Variable] [Fintype Alphabet] [Nonempty Alphabet]
    (csp : DenseMaxFourCSP Variable Alphabet)
    (epsilon : ℝ) :
    RandomizedProcedure Unit (Variable → Alphabet) where
  Seed := ptas.Seed
  seedMeasurableSpace := ptas.seedMeasurableSpace
  seedMeasure := ptas.seedMeasure
  seedProbability := ptas.seedProbability
  run := fun _ seed =>
    ptas.solve Variable Alphabet csp epsilon seed
  runtime := fun _ seed =>
    ptas.runtime Variable Alphabet csp epsilon seed

/-- Precise efficient exact-Haar-sampling contract.  The pushforward law of
the sampler is exactly normalized Haar measure, not merely an approximate
design. -/
structure EfficientHaarSamplingContract where
  runtimeConstant : ℕ
  runtimeDegree : ℕ
  sample :
    ∀ d : ℕ,
      RandomizedProcedure Unit (Matrix.unitaryGroup (Fin d) ℂ)
  sample_measurable :
    ∀ d,
      @Measurable
        (sample d).Seed (Matrix.unitaryGroup (Fin d) ℂ)
        (sample d).seedMeasurableSpace (measurableSpaceUnitaryGroup d)
        ((sample d).run ())
  exact_law :
    ∀ d,
      @Measure.map
        (sample d).Seed (Matrix.unitaryGroup (Fin d) ℂ)
        (sample d).seedMeasurableSpace (measurableSpaceUnitaryGroup d)
        ((sample d).run ()) (sample d).seedMeasure =
          unitaryHaarMeasure d
  polynomial_runtime :
    ∀ d seed,
      (sample d).runtime () seed ≤
        runtimeConstant * (d + 1) ^ runtimeDegree

/-- Operations charged one unit by the real-RAM model. -/
inductive RealRAMPrimitive
  | add | sub | mul | div | sqrt | compare
  deriving DecidableEq, Fintype

/-- Precise real-RAM contract used for the complexity statements: registers
represent mathematical reals exactly and every listed primitive has unit
cost.  Division and square root expose their natural domains. -/
structure RealRAMModelContract where
  Register : Type
  value : Register ≃ ℝ
  add : Register → Register → Register
  sub : Register → Register → Register
  mul : Register → Register → Register
  div : Register → {r : Register // value r ≠ 0} → Register
  sqrt : {r : Register // 0 ≤ value r} → Register
  compare : Register → Register → Ordering
  add_spec : ∀ x y, value (add x y) = value x + value y
  sub_spec : ∀ x y, value (sub x y) = value x - value y
  mul_spec : ∀ x y, value (mul x y) = value x * value y
  div_spec : ∀ x y, value (div x y) = value x / value y
  sqrt_spec : ∀ x, value (sqrt x) = Real.sqrt (value x)
  compare_spec :
    ∀ x y,
      compare x y =
        if value x < value y then Ordering.lt
        else if value x = value y then Ordering.eq
        else Ordering.gt
  primitiveCost : RealRAMPrimitive → ℕ
  primitiveCost_eq_one : ∀ op, primitiveCost op = 1

end

end QuantumSep
